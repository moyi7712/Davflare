# Davflare NAS 环境变量（复制为 .env 后填写）

# ── daemon 核心 ──────────────────────────────
# daemon：shim 访问 R2 API 的 Bearer token（必须；与 workerd/davflare.compose.capnp 的 DAEMON_TOKEN 一致）
DAEMON_TOKEN=change-me-long-random-token

# 本地 bucket 名（文件落在 ./data/<bucket>/；也是云端同步的默认桶名）
DAEMON_BUCKET=webdav

# 云端同步目标（仅环境变量配置，管理页面不可改；远端名与 RCLONE_CONFIG_<远端>_* 凭据对应）
DAEMON_REMOTE=r2
DAEMON_REMOTE_BUCKET=webdav

# ── 管理平面登录（:9001，独立于 Davflare 的 WebDAV 账号密码）──
DAEMON_MGMT_USER=admin
DAEMON_MGMT_PASS=change-me-mgmt-pass

# ── workerd 侧账号（与 workerd/davflare.compose.capnp 中保持一致）──
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=change-me

# ── Cloudflare R2 云端同步凭据（rclone env-var 远端配置，免 rclone.conf 文件）──
# 获取：Cloudflare Dashboard → R2 → Manage API Tokens → Create API Token（Object Read & Write）
# 变量名中的 R2 即远端名（管理页面「远端」默认 r2）；改远端名需同步改这组前缀
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# 桶级 scoped token 会拒绝 HeadBucket → rclone 误判桶不存在去 CreateBucket（403）；必须跳过检查
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# ── 同步方式与计划不走 env ──────────────────
# push/pull/bisync、cron/间隔、远端/桶 全部在管理平面 http://NAS_IP:9001 页面设置，
# 持久化到 ./config/daemon-config.json（页面改完即时生效，重启不丢）
